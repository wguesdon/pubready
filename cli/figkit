#!/usr/bin/env bash
# figkit: the stable command surface for pubready. The agent calls this, not R
# or Python directly. Every command runs inside the pinned Podman image with the
# core scripts mounted read-only, so the environment is reproducible.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CORE_DIR="$REPO_ROOT/core"
VERSION="$(cat "$REPO_ROOT/VERSION" 2>/dev/null || echo 0.0.0)"
IMAGE="${PUBREADY_IMAGE:-localhost/pubready:$VERSION}"

usage() {
  cat <<'EOF'
figkit — reproducible publication figures

Usage:
  figkit inspect --data FILE [--sheet S] [--format text|json]
  figkit diagnose --recipe NAME --data FILE [--x COL --y COL ...]
  figkit plot --recipe NAME --data FILE --x COL --y COL [options]
  figkit render --config plot_config.yaml [--data FILE]
  figkit build
  figkit shell
  figkit test
  figkit version

Common plot options:
  --engine r|python                        recipe engine (default r)
  --llm-provider NAME                     LLM provider recorded in the report
  --llm-model NAME                        LLM model recorded in the report
  --agent-harness NAME                    agent harness recorded in the report
  --agent-harness-version VERSION         agent harness version in the report
  --x, --y                                 axis columns (tidy data)
  --fill, --facet                          extra factors (factorial_anova); --facet is
                                           the feature column of feature_panel
  --time, --event                          survival columns (1 = event, 0 = censored);
                                           swimmer duration and status (0 = ongoing);
                                           cumulative_incidence status (0 = censored,
                                           other codes = causes)
  --markers "a,b"                          event-time columns drawn on the bars (swimmer)
  --ref LEVEL                              reference (control) group (estimation_plot)
  --cause CODE                             event code of the cause of interest
                                           (cumulative_incidence, default 1)
  --covariates "a,b,c"                     Cox model covariates
  --annotation FILE                        heatmap column annotation CSV
  --id COL                                 subject or sample column (paired_compare,
                                           spider_response, timecourse, waterfall,
                                           estimation_plot, standard_curve, sankey,
                                           composition)
  --group COL                              grouping column (pca, dose_response, timecourse,
                                           spider_response, waterfall, enzyme_kinetics,
                                           composition, embedding); the chromosome
                                           column of manhattan
  --label COL                              label column (volcano, ma_plot, manhattan,
                                           enrichment_dot, pca, forest_meta)
  --positive LEVEL                         case level of the outcome (roc_curve,
                                           calibration)
  --ci_low COL, --ci_high COL, --se COL    study interval or standard error (forest_meta)
  --measure auto|ratio|difference          pooling scale (forest_meta)
  --pd_threshold N, --pr_threshold N       RECIST lines (spider_response, waterfall)
  --scale row|column|none                  heatmap value scaling
  --cluster both|rows|columns|none         heatmap / correlation clustering
  --fc_cutoff N, --p_cutoff N              volcano and ma_plot thresholds (default 1, 0.05)
  --top_n N                                labels / terms / intersections to show
                                           (volcano, ma_plot, manhattan, enrichment_dot, upset)
  --test auto|welch_t|wilcoxon|anova|kruskal|art   choose or force the test
                                           (correlation: auto|pearson|spearman|kendall;
                                            proportions: auto|chisq|fisher;
                                            timecourse: auto|gg|uncorrected;
                                            standard_curve: auto|linear|4pl;
                                            feature_panel: auto|welch_t|wilcoxon|anova|kruskal)
  --paired                                 paired design
  --geom box|violin|bar|raincloud          plot geometry (comparison recipes);
                                           factorial_anova also takes interaction
  --theme pubready_house|prism              figure style (comparison + correlation)
  --xlab, --ylab, --title                  labels
  --palette "#3B6DB3,#C1432B"              fill colors
  --out DIR                                output root (default pubready_output)

Recipes: two_group_compare, multi_group_compare, factorial_anova,
         survival_km, cox_forest, heatmap, correlation,
         correlation_heatmap, upset, volcano, enrichment_dot,
         paired_compare, proportions, pca, spider_response,
         dose_response, roc_curve, bland_altman, forest_meta,
         timecourse, waterfall, swimmer, estimation_plot,
         enzyme_kinetics, standard_curve, cumulative_incidence,
         calibration, sankey, ma_plot, manhattan, feature_panel,
         embedding, distribution, composition
EOF
}

image_id()      { podman image inspect --format '{{.Id}}'     "$IMAGE" 2>/dev/null || echo ""; }
image_digest()  { podman image inspect --format '{{.Digest}}' "$IMAGE" 2>/dev/null || echo ""; }
podman_version(){ podman --version 2>/dev/null | awk '{print $3}'; }

git_dirty() {
  if [ -n "$(git -C "$REPO_ROOT" status --porcelain 2>/dev/null)" ]; then
    echo true
  else
    echo false
  fi
}

require_tracked_report_source() {
  if ! git -C "$REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Report generation requires a Git checkout." >&2
    exit 1
  fi
  local untracked
  untracked="$(git -C "$REPO_ROOT" ls-files --others --exclude-standard)"
  if [ -n "$untracked" ]; then
    echo "Report generation stopped because the repository has untracked files:" >&2
    printf '%s\n' "$untracked" >&2
    exit 1
  fi
}

REPORT_LLM_PROVIDER="none"
REPORT_LLM_MODEL="none"
REPORT_AGENT_HARNESS="manual"
REPORT_AGENT_HARNESS_VERSION="not_recorded"
REPORT_ARGS=()

parse_report_options() {
  REPORT_ARGS=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --llm-provider|--llm-model|--agent-harness|--agent-harness-version)
        if [ "$#" -lt 2 ]; then
          echo "Missing value for $1." >&2
          exit 1
        fi
        case "$1" in
          --llm-provider) REPORT_LLM_PROVIDER="$2" ;;
          --llm-model) REPORT_LLM_MODEL="$2" ;;
          --agent-harness) REPORT_AGENT_HARNESS="$2" ;;
          --agent-harness-version) REPORT_AGENT_HARNESS_VERSION="$2" ;;
        esac
        shift 2
        ;;
      *)
        REPORT_ARGS+=("$1")
        shift
        ;;
    esac
  done
}

require_image() {
  if ! podman image exists "$IMAGE"; then
    echo "Image '$IMAGE' not found. Build it first: figkit build" >&2
    exit 1
  fi
}

# Shared podman run for either engine. $1 = interpreter+script; rest = args.
container_run() {
  require_image
  podman --log-level=error run --rm \
    -v "$PWD":/work -w /work \
    -v "$CORE_DIR":/opt/pubready/core:ro \
    -e PUBREADY_CORE=/opt/pubready/core \
    -e PUBREADY_IMAGE="$IMAGE" \
    -e PUBREADY_IMAGE_ID="$(image_id)" \
    -e PUBREADY_IMAGE_DIGEST="$(image_digest)" \
    -e PUBREADY_PODMAN_VERSION="$(podman_version)" \
    -e PUBREADY_GIT_COMMIT="$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || echo unknown)" \
    -e PUBREADY_GIT_DIRTY="$(git_dirty)" \
    -e PUBREADY_LLM_PROVIDER="$REPORT_LLM_PROVIDER" \
    -e PUBREADY_LLM_MODEL="$REPORT_LLM_MODEL" \
    -e PUBREADY_AGENT_HARNESS="$REPORT_AGENT_HARNESS" \
    -e PUBREADY_AGENT_HARNESS_VERSION="$REPORT_AGENT_HARNESS_VERSION" \
    -e PUBREADY_CREATED="${PUBREADY_CREATED:-}" \
    -e PYTHONPATH=/opt/pubready/core/python \
    "$IMAGE" "$@"
}

run_r()  { local e="$1"; shift; container_run Rscript "/opt/pubready/core/r/entry/${e}.R" "$@"; }
run_py() { local e="$1"; shift; [ "$e" = "inspect" ] && e="inspect_data"; container_run python3 "/opt/pubready/core/python/entry/${e}.py" "$@"; }

# Run both engines' unit suites inside the image against the mounted source, so
# the tested code is exactly what figkit runs. core is mounted read-only.
# The public benchmark datasets and their reference values are mounted too, so
# both suites can check every recipe against an independent computation.
run_tests() {
  require_image
  echo "== R engine (testthat) =="
  podman --log-level=error run --rm \
    -v "$CORE_DIR":/opt/pubready/core:ro \
    -v "$REPO_ROOT/benchmarks":/opt/pubready/benchmarks:ro \
    -e PUBREADY_CORE=/opt/pubready/core \
    -e PUBREADY_CORE_R=/opt/pubready/core/r \
    -e PUBREADY_BENCHMARKS=/opt/pubready/benchmarks \
    "$IMAGE" Rscript /opt/pubready/core/r/tests/run_tests.R
  echo
  echo "== Python engine (pytest) =="
  podman --log-level=error run --rm \
    -v "$CORE_DIR":/opt/pubready/core:ro \
    -v "$REPO_ROOT/benchmarks":/opt/pubready/benchmarks:ro \
    -e PYTHONPATH=/opt/pubready/core/python \
    -e PUBREADY_BENCHMARKS=/opt/pubready/benchmarks \
    "$IMAGE" python3 -m pytest /opt/pubready/core/python/tests -q -p no:cacheprovider
}

show_version() {
  echo "pubready $VERSION"
  if podman image exists "$IMAGE" 2>/dev/null; then
    echo "image:  $IMAGE"
    echo "id:     $(image_id)"
    echo "digest: $(image_digest)"
  else
    echo "image:  $IMAGE (not built; run: figkit build)"
  fi
  echo "podman: $(podman_version)"
  echo "commit: $(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)"
}

# Read the value of --engine from the argument list (default r).
engine_of() {
  local prev="" e="r"
  for a in "$@"; do
    [ "$prev" = "--engine" ] && e="$a"
    prev="$a"
  done
  echo "$e"
}

dispatch() {
  local cmd="$1"; shift
  if [ "$cmd" = "plot" ] || [ "$cmd" = "render" ]; then
    require_tracked_report_source
  fi
  parse_report_options "$@"
  if [ "$(engine_of "${REPORT_ARGS[@]}")" = "python" ]; then
    run_py "$cmd" "${REPORT_ARGS[@]}"
  else
    run_r "$cmd" "${REPORT_ARGS[@]}"
  fi
}

cmd="${1:-}"; [ $# -gt 0 ] && shift || true

case "$cmd" in
  inspect)  dispatch inspect  "$@" ;;
  diagnose) dispatch diagnose "$@" ;;
  plot)     dispatch plot     "$@" ;;
  render)   dispatch render   "$@" ;;
  build)
    podman build -t "$IMAGE" \
      --build-arg "PUBREADY_VERSION=$VERSION" \
      -f "$REPO_ROOT/container/Containerfile" "$REPO_ROOT"
    ;;
  test)    run_tests ;;
  version|--version|-v) show_version ;;
  shell)
    require_image
    podman --log-level=error run --rm -it \
      -v "$PWD":/work -w /work \
      -v "$CORE_DIR":/opt/pubready/core:ro \
      -e PUBREADY_CORE=/opt/pubready/core \
      "$IMAGE" bash
    ;;
  ""|-h|--help|help) usage ;;
  *) echo "unknown command: $cmd" >&2; usage; exit 1 ;;
esac
