# pubready environment image: R + Python, both engines, pinned by image digest.
# Application code (core/) is mounted at runtime and pinned separately by the
# pubready git commit recorded in each bundle's manifest.
FROM docker.io/rocker/r-ver:4.4.1

# System libraries: build deps for R graphics packages, plus Python.
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates \
      python3 python3-venv python3-dev \
      libcurl4-openssl-dev libssl-dev libxml2-dev \
      libfontconfig1-dev libfreetype6-dev libpng-dev libtiff5-dev libjpeg-dev \
      libharfbuzz-dev libfribidi-dev \
      pandoc \
 && rm -rf /var/lib/apt/lists/*

# R packages. rocker/r-ver pins the Posit Package Manager snapshot to the R
# release date, so these installs are reproducible and use binary builds.
RUN install2.r --error --skipinstalled \
      ggplot2 ggpubr rstatix ggprism \
      readr readxl \
      jsonlite digest yaml optparse svglite scales \
      ARTool emmeans broom car \
      survival survminer \
 && rm -rf /tmp/downloaded_packages

# Python packages via uv. The built image freezes the resolved set into
# requirements.lock, which together with the image digest is the pin.
COPY container/requirements.txt /opt/pubready/requirements.txt
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
 && ln -s /root/.local/bin/uv /usr/local/bin/uv \
 && uv venv /opt/pubready/venv \
 && VIRTUAL_ENV=/opt/pubready/venv uv pip install --no-cache -r /opt/pubready/requirements.txt \
 && VIRTUAL_ENV=/opt/pubready/venv uv pip freeze > /opt/pubready/requirements.lock
ENV PATH="/opt/pubready/venv/bin:${PATH}"

# Bioconductor: ComplexHeatmap (+ circlize from CRAN) for the heatmap recipe.
# Placed after the Python layer so that layer stays cached across this add.
RUN install2.r --error --skipinstalled circlize GetoptLong \
 && R -q -e 'if (!requireNamespace("BiocManager", quietly=TRUE)) install.packages("BiocManager"); BiocManager::install("ComplexHeatmap", update=FALSE, ask=FALSE)' \
 && rm -rf /tmp/downloaded_packages

# Extra Python packages for the Python engine (survival, factorial, heatmap).
# Separate layer so the R/Bioconductor layers above stay cached across this add.
COPY container/requirements-extra.txt /opt/pubready/requirements-extra.txt
RUN VIRTUAL_ENV=/opt/pubready/venv uv pip install --no-cache -r /opt/pubready/requirements-extra.txt \
 && VIRTUAL_ENV=/opt/pubready/venv uv pip freeze > /opt/pubready/requirements.lock

# Extra CRAN packages added after v0.3.0: ggrepel + ggdist for the volcano labels
# and the raincloud geom. A late layer so the heavy R/Bioconductor and Python
# layers above stay cached across this add.
RUN install2.r --error --skipinstalled ggrepel ggdist \
 && rm -rf /tmp/downloaded_packages

# Bioconductor packages used only to build the airway volcano example: DESeq2 for
# the differential expression on the airway benchmark (GSE52778) and org.Hs.eg.db
# to label genes by symbol. Not a recipe dependency -- the volcano recipe only
# reads a DE table. A late layer so the layers above stay cached across this add.
RUN R -q -e 'BiocManager::install(c("DESeq2", "airway", "org.Hs.eg.db"), update=FALSE, ask=FALSE)' \
 && rm -rf /tmp/downloaded_packages

# Test tooling: testthat (R) and pytest (Python), used by `figkit test`. A late
# layer so the heavy R/Bioconductor and Python engine layers above stay cached
# across this add. pytest is intentionally not frozen into requirements.lock: it
# is a dev tool, not a runtime dependency of figure generation.
RUN install2.r --error --skipinstalled testthat \
 && rm -rf /tmp/downloaded_packages
RUN VIRTUAL_ENV=/opt/pubready/venv uv pip install --no-cache "pytest>=7"

# Core scripts are mounted here at runtime by the figkit CLI.
RUN mkdir -p /opt/pubready/core

ARG PUBREADY_VERSION=0.0.0
LABEL org.opencontainers.image.title="pubready" \
      org.opencontainers.image.version="${PUBREADY_VERSION}" \
      org.opencontainers.image.description="R and Python environment for reproducible publication-ready figures"
